// PerfiosDetailsDAO (interface)
void updateZipFailed(String cifNumber, String remark);

// PerfiosDetailsDAOImpl
@Override
public void updateZipFailed(String cifNumber, String remark) {
    String sql = "update kycupdate.kyc_perfios_customer_details "
               + "set cif_status='ZF', modified_date=sysdate, remark=? "
               + "where cif_number=? and cif_status='ZP'";
    try {
        int rows = jdbcTemplate.update(sql, remark, cifNumber);
        logger.info("ZF status set for CIF {} , rows updated {}", cifNumber, rows);
    } catch (Exception e) {
        logger.error("Exception while setting ZF for CIF " + cifNumber, e);
    }
}
